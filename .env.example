# Copy to .env.local and fill in. .env.local is git-ignored. Never commit a real key.
#
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model ids are overridable because Gemini model names change often.
# Run `npm run smoke` once with your key: it lists the models your key can use.
GEMINI_MODEL_PRIMARY=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Optional: per-IP requests allowed per minute on /api/* (protects your quota)
RATE_LIMIT_PER_MINUTE=20
